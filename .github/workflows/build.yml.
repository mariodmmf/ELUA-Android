name: Compila ELUA Halo APK (debug)

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  android-debug:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Scarica contenuti del repository
        uses: actions/checkout@v4
      - name: Espandi sorgenti ELUA
        run: |
          test -f ELUA_SORGENTI_PER_BUILD.zip
          mkdir workspace
          unzip -q ELUA_SORGENTI_PER_BUILD.zip -d workspace
          test -f workspace/app/build.gradle
      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Android SDK
        uses: android-actions/setup-android@v3
      - name: Installa Android SDK 35
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Gradle 8.11.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'
      - name: Esegui test Java locali
        working-directory: workspace
        run: |
          mkdir -p build/desktop-test
          javac -d build/desktop-test app/src/main/java/it/spunto/companion/LocalRules.java app/src/main/java/it/spunto/companion/EluaPolicy.java app/src/main/java/it/spunto/companion/EluaCutoutPlacement.java tests/LocalRulesSmokeTest.java tests/EluaPolicyTest.java tests/EluaCutoutPlacementTest.java
          java -cp build/desktop-test it.spunto.companion.LocalRulesSmokeTest
          java -cp build/desktop-test it.spunto.companion.EluaPolicyTest
          java -cp build/desktop-test it.spunto.companion.EluaCutoutPlacementTest
      - name: Compila APK Android
        working-directory: workspace
        run: gradle --no-daemon --stacktrace :app:assembleDebug
      - name: Verifica firma APK e calcola SHA256
        working-directory: workspace
        run: |
          test -s app/build/outputs/apk/debug/app-debug.apk
          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --verbose app/build/outputs/apk/debug/app-debug.apk
          sha256sum app/build/outputs/apk/debug/app-debug.apk | tee SHA256SUMS.txt
      - name: Pubblica APK da scaricare
        uses: actions/upload-artifact@v4
        with:
          name: ELUA-v0.10-Halo-APK-debug
          path: |
            workspace/app/build/outputs/apk/debug/app-debug.apk
            workspace/SHA256SUMS.txt
          if-no-files-found: error
          retention-days: 7
